import("//webrtc.gni")

group("linko_rw04_all_probes") {
  deps = [ ":linko_rw04_probe" ]
  if (is_mac) {
    deps += [
      ":linko_rw04_macos_h264",
      ":linko_rw04_macos_window",
      ":linko_rw04_macos_loopback",
      ":linko_rw04_macos_window_loopback",
    ]
  }
  if (is_win) {
    deps += [
      ":linko_rw04_windows_loopback",
      ":linko_rw04_windows_h264_rtp",
    ]
  }
}

rtc_executable("linko_rw04_probe") {
  sources = [ "frame_probe.cc" ]
  deps = [ "//api/video:video_frame" ]
}

codec_core_deps = [
  "//api/environment:environment_factory",
  "//api/video:video_frame",
  "//api/video_codecs:video_codecs_api",
]
loopback_deps = [
  "//api:candidate",
  "//api:create_modular_peer_connection_factory",
  "//api:enable_media",
  "//api:jsep",
  "//api:media_stream_interface",
  "//api:peer_connection_interface",
  "//api:rtp_receiver_interface",
  "//api:rtp_transceiver_interface",
  "//api:set_local_description_observer_interface",
  "//api:set_remote_description_observer_interface",
  "//api/audio:audio_device",
  "//api/audio_codecs:builtin_audio_decoder_factory",
  "//api/audio_codecs:builtin_audio_encoder_factory",
  "//api/video:video_broadcaster",
  "//modules/audio_device:audio_device_impl",
  "//p2p:basic_packet_socket_factory",
  "//p2p:basic_port_allocator",
  "//pc:session_description",
  "//pc:video_track_source",
  "//rtc_base:ip_address",
  "//rtc_base:network",
  "//rtc_base:socket_address",
  "//rtc_base:socket_server",
  "//rtc_base:ssl",
  "//rtc_base:threading",
]

if (is_win) {
  rtc_executable("linko_rw04_windows_h264_rtp") {
    sources = [ "windows_h264_rtp.cc" ]
    deps = [
      "//common_video",
      "//modules/rtp_rtcp:rtp_rtcp",
      "//modules/video_coding:video_coding",
    ]
    libs = [
      "mf.lib",
      "mfplat.lib",
      "mfuuid.lib",
      "ole32.lib",
      "wmcodecdspuuid.lib",
    ]
  }
  rtc_executable("linko_rw04_windows_loopback") {
    sources = [
      "local_transport_common.inc",
      "local_transport_windows.cc",
    ]
    deps = codec_core_deps + loopback_deps + [
      "//api/video_codecs:video_decoder_factory_template",
      "//api/video_codecs:video_decoder_factory_template_libvpx_vp8_adapter",
      "//api/video_codecs:video_encoder_factory_template",
      "//api/video_codecs:video_encoder_factory_template_libvpx_vp8_adapter",
      "//rtc_base:win32_socket_init",
    ]
  }
}

if (is_mac) {
  codec_deps = codec_core_deps + [
    "//sdk:native_api",
    "//sdk:videoframebuffer_objc",
    "//sdk:videotoolbox_objc",
  ]
  objc_includes = [
    "//sdk/objc",
    "//sdk/objc/base",
  ]
  preview_frameworks = [
    "AppKit.framework",
    "CoreGraphics.framework",
    "CoreImage.framework",
    "CoreMedia.framework",
    "CoreVideo.framework",
    "Foundation.framework",
    "QuartzCore.framework",
    "ScreenCaptureKit.framework",
  ]
  rtc_executable("linko_rw04_macos_h264") {
    sources = [
      "h264_probe.h",
      "h264_probe.mm",
      "h264_probe_main.c",
    ]
    configs += [ "//:common_objc" ]
    include_dirs = objc_includes
    frameworks = [
      "CoreVideo.framework",
      "Foundation.framework",
    ]
    deps = codec_deps
  }
  rtc_executable("linko_rw04_macos_window") {
    sources = [
      "h264_probe.h",
      "h264_probe.mm",
      "macos_capture.m",
    ]
    defines = [
      "LINKO_RW03_CI",
      "LINKO_RW04_CODEC_PREVIEW",
    ]
    configs += [ "//:common_objc" ]
    include_dirs = objc_includes
    frameworks = preview_frameworks
    deps = codec_deps
  }
  rtc_executable("linko_rw04_macos_loopback") {
    sources = [
      "local_transport.mm",
      "local_transport_common.inc",
      "loopback_preview.h",
    ]
    configs += [ "//:common_objc" ]
    include_dirs = objc_includes
    frameworks = [
      "CoreVideo.framework",
      "Foundation.framework",
    ]
    deps = codec_deps + loopback_deps
  }
  rtc_executable("linko_rw04_macos_window_loopback") {
    sources = [
      "local_transport.mm",
      "local_transport_common.inc",
      "loopback_preview.h",
      "macos_capture.m",
      "vm_probe.cc",
      "vm_probe.h",
    ]
    defines = [
      "LINKO_RW03_CI",
      "LINKO_RW04_NETWORK_PREVIEW",
    ]
    configs += [ "//:common_objc" ]
    include_dirs = objc_includes
    frameworks = preview_frameworks
    deps = codec_deps + loopback_deps + [ "//third_party/libyuv" ]
  }
}
